// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Dokument magazynowy (WZ - Wydanie Zewnętrzne)
model Document {
  id              String         @id @default(cuid())
  warehouseWorker String         // Magazynier
  date            DateTime       @default(now())
  notes           String?        // Uwagi
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           DocumentItem[] // Pozycje w dokumencie

  @@index([date])
}

// Produkt w bazie
model Product {
  id        String         @id @default(cuid())
  barcode   String         @unique // Kod kreskowy EAN-13
  name      String         // Nazwa produktu
  isManual  Boolean        @default(false) // Czy dodany ręcznie
  createdAt DateTime       @default(now())
  items     DocumentItem[] // W jakich dokumentach występuje

  @@index([barcode])
}

// Pozycja w dokumencie (produkt + ilość)
model DocumentItem {
  id         String   @id @default(cuid())
  documentId String
  productId  String
  quantity   Int      @default(1) // Ilość sztuk
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([documentId])
  @@index([productId])
}
