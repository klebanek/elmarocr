# Lokalna baza danych (development)
DATABASE_URL="file:./dev.db"

# Dla produkcji (Vercel) - użyj Turso
# 1. Zainstaluj Turso CLI: https://docs.turso.tech/cli/installation
# 2. Utwórz bazę: turso db create elmar-warehouse
# 3. Pobierz URL: turso db show elmar-warehouse --url
# 4. Pobierz token: turso db tokens create elmar-warehouse
# 5. Dodaj do Vercel Environment Variables:
#    DATABASE_URL="libsql://[your-database-url]"
#    TURSO_AUTH_TOKEN="[your-auth-token]"

# Przykład:
# DATABASE_URL="libsql://elmar-warehouse-username.turso.io"
# TURSO_AUTH_TOKEN="eyJhbGc..."
